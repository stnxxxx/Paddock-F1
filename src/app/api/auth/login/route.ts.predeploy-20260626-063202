import { getDb } from "@/db"
import { createToken, apiResponse, apiError, setAuthCookie } from "@/lib/auth"
import { rateLimitGuard } from "@/lib/rate-limit"
import bcrypt from "bcryptjs"

export async function POST(req: Request) {
  try {
    const limited = rateLimitGuard(req, "login", 10, 5 * 60 * 1000)
    if (limited) return limited

    const { email, password } = await req.json()
    if (!email || !password) return apiError("Email и пароль обязательны")

    const db = getDb()
    const user = await db.get(
      "SELECT id, username, display_name, email, team, driver, role, avatar, cover, bio, karma, onboarded, banned, password_hash FROM users WHERE email = $1",
      [String(email).trim().toLowerCase()]
    ) as any

    if (!user || !bcrypt.compareSync(String(password), user.password_hash)) {
      return apiError("Неверный email или пароль", 401)
    }

    if (user.banned) return apiError("Аккаунт заблокирован", 403)

    const flairs = await db.all(
      "SELECT f.id, f.name, f.icon, f.color FROM flairs f JOIN user_flairs uf ON uf.flair_id = f.id WHERE uf.user_id = $1",
      [user.id]
    ) as any[]

    const token = await createToken({ userId: user.id, username: user.username })
    await setAuthCookie(token)

    return apiResponse({
      user: { id: user.id, username: user.username, display_name: user.display_name, email: user.email, team: user.team, driver: user.driver, role: user.role, avatar: user.avatar, cover: user.cover, bio: user.bio, karma: user.karma, onboarded: user.onboarded, flairs: flairs || [] },
    })
  } catch {
    return apiError("Ошибка входа", 500)
  }
}