# Copy to .env.local for local runs, or set these in your hosting provider.

# REQUIRED in production. Must be a long, random string (>= 16 chars).
# The app refuses to issue/verify auth tokens in production without a strong value.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# Public site URL — used for metadata, sitemap URLs, and server-rendered race pages.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: password for the seeded admin account (news@paddock.local).
# In production, if unset, a random password is generated and logged once at startup;
# recover access via the password-reset flow.
# SEED_ADMIN_PASSWORD=""

# Optional: set to "1" to also seed demo community accounts/posts in production.
# Demo data is seeded automatically in non-production environments.
# SEED_DEMO="0"

# Email (Gmail SMTP) for auth verification codes (registration / passwordless login / password reset).
# Create a Google "App Password" (Account → Security → 2-Step Verification → App passwords).
# If these are unset, codes are logged to the server console instead of being emailed.
# GMAIL_USER="you@gmail.com"
# GMAIL_APP_PASSWORD="16-char-app-password-without-spaces"
# GMAIL_FROM=""  # optional display from-address; defaults to GMAIL_USER
