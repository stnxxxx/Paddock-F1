import { latestBy, normalizeTeam, toNumber } from "./normalizer"
import { LiveDriverSnapshot, LiveEvent, OpenF1Driver, OpenF1Session } from "./types"
import { memoized } from "./cache"

const OPENF1_BASE = "https://api.openf1.org/v1"

interface OpenF1Interval {
  date: string
  driver_number: number
  gap_to_leader?: number | string | null
  interval?: number | string | null
}

interface OpenF1Position {
  date: string
  driver_number: number
  position: number
}

interface OpenF1Lap {
  driver_number: number
  lap_number: number
  lap_duration?: number
  duration_sector_1?: number
  duration_sector_2?: number
  duration_sector_3?: number
  i1_speed?: number
  i2_speed?: number
  st_speed?: number
  is_pit_out_lap?: boolean
}

export type { OpenF1Lap, OpenF1Stint }

interface OpenF1CarData {
  date: string
  driver_number: number
  speed?: number
  throttle?: number
  brake?: number
  n_gear?: number
  rpm?: number
  drs?: number
}

interface OpenF1Stint {
  driver_number: number
  compound?: string
  lap_start?: number
  lap_end?: number
}

interface OpenF1Pit {
  date: string
  driver_number: number
  lap_number?: number
  pit_duration?: number
  stop_duration?: number
}

interface OpenF1RaceControl {
  date: string
  category?: string
  flag?: string
  message?: string
  driver_number?: number
  lap_number?: number
}

interface OpenF1Weather {
  date: string
  air_temperature?: number
  track_temperature?: number
  humidity?: number
  rainfall?: number
  wind_speed?: number
}

async function fetchOpenF1<T>(path: string, ttlMs: number): Promise<T[]> {
  const url = `${OPENF1_BASE}/${path.replace(/^\/+/, "")}`
  return memoized(`f1:openf1:${path}`, ttlMs, async () => {
    const res = await fetch(url, { cache: "no-store" })
    if (!res.ok) throw new Error(`OpenF1 API returned ${res.status}`)
    return (await res.json()) as T[]
  })
}

export async function getLatestSession(): Promise<OpenF1Session | null> {
  const sessions = await fetchOpenF1<OpenF1Session>("sessions?session_key=latest", 15 * 1000)
  return sessions[0] || null
}

export async function getSession(sessionKey: number | "latest"): Promise<OpenF1Session | null> {
  const sessions = await fetchOpenF1<OpenF1Session>(`sessions?session_key=${sessionKey}`, 30 * 1000)
  return sessions[0] || null
}

export async function getDrivers(sessionKey: number | "latest"): Promise<OpenF1Driver[]> {
  return fetchOpenF1<OpenF1Driver>(`drivers?session_key=${sessionKey}`, 60 * 1000)
}

/** All timed laps for a session — includes sector durations and trap speeds. */
export async function getLaps(sessionKey: number): Promise<OpenF1Lap[]> {
  return fetchOpenF1<OpenF1Lap>(`laps?session_key=${sessionKey}`, 60 * 1000)
}

/** All sessions for a season (practice/quali/sprint/race), for stat pickers. */
export async function getSessions(year: number): Promise<OpenF1Session[]> {
  return fetchOpenF1<OpenF1Session>(`sessions?year=${year}`, 5 * 60 * 1000)
}

/** Tyre stints (compound + lap range) for a session. */
export async function getStints(sessionKey: number): Promise<OpenF1Stint[]> {
  return fetchOpenF1<OpenF1Stint>(`stints?session_key=${sessionKey}`, 60 * 1000)
}

export async function getLiveDriverSnapshots(sessionKey: number): Promise<LiveDriverSnapshot[]> {
  const [drivers, intervals, positions, laps, carData, stints] = await Promise.all([
    getDrivers(sessionKey),
    fetchOpenF1<OpenF1Interval>(`intervals?session_key=${sessionKey}`, 4 * 1000).catch(() => []),
    fetchOpenF1<OpenF1Position>(`position?session_key=${sessionKey}`, 4 * 1000).catch(() => []),
    fetchOpenF1<OpenF1Lap>(`laps?session_key=${sessionKey}`, 10 * 1000).catch(() => []),
    fetchOpenF1<OpenF1CarData>(`car_data?session_key=${sessionKey}`, 2 * 1000).catch(() => []),
    fetchOpenF1<OpenF1Stint>(`stints?session_key=${sessionKey}`, 30 * 1000).catch(() => []),
  ])

  return drivers.map((driver) => {
    const driverNumber = driver.driver_number
    const lastInterval = latestBy(intervals.filter((i) => i.driver_number === driverNumber), (i) => i.date)
    const lastPosition = latestBy(positions.filter((p) => p.driver_number === driverNumber), (p) => p.date)
    const driverLaps = laps.filter((lap) => lap.driver_number === driverNumber)
    const lastLap = [...driverLaps].sort((a, b) => b.lap_number - a.lap_number)[0]
    const bestLap = driverLaps
      .map((lap) => lap.lap_duration)
      .filter((duration): duration is number => typeof duration === "number" && duration > 0)
      .sort((a, b) => a - b)[0]
    const telemetry = latestBy(carData.filter((sample) => sample.driver_number === driverNumber), (sample) => sample.date)
    const stint = stints
      .filter((s) => s.driver_number === driverNumber)
      .sort((a, b) => (b.lap_start || 0) - (a.lap_start || 0))[0]
    const team = normalizeTeam(driver.team_name)

    return {
      driverNumber,
      code: driver.name_acronym || String(driverNumber),
      name: driver.full_name || driver.broadcast_name || `#${driverNumber}`,
      team,
      teamColor: driver.team_colour ? `#${driver.team_colour.replace(/^#/, "")}` : undefined,
      position: lastPosition?.position,
      interval: lastInterval?.interval ?? null,
      gapToLeader: lastInterval?.gap_to_leader ?? null,
      lastLap: toNumber(lastLap?.lap_duration) ?? null,
      bestLap: bestLap ?? null,
      lapNumber: lastLap?.lap_number,
      sectors: lastLap ? [
        toNumber(lastLap.duration_sector_1) ?? null,
        toNumber(lastLap.duration_sector_2) ?? null,
        toNumber(lastLap.duration_sector_3) ?? null,
      ] : undefined,
      tyre: stint?.compound,
      stintLapStart: stint?.lap_start,
      telemetry: telemetry ? {
        speed: telemetry.speed,
        throttle: telemetry.throttle,
        brake: telemetry.brake,
        gear: telemetry.n_gear,
        rpm: telemetry.rpm,
        drs: telemetry.drs,
        sampledAt: telemetry.date,
      } : undefined,
    }
  }).sort((a, b) => (a.position || 999) - (b.position || 999))
}

export async function getLiveEvents(sessionKey: number): Promise<LiveEvent[]> {
  const [raceControl, pit] = await Promise.all([
    fetchOpenF1<OpenF1RaceControl>(`race_control?session_key=${sessionKey}`, 10 * 1000).catch(() => []),
    fetchOpenF1<OpenF1Pit>(`pit?session_key=${sessionKey}`, 15 * 1000).catch(() => []),
  ])

  const controlEvents: LiveEvent[] = raceControl.slice(-12).map((event) => ({
    type: "race_control",
    title: event.flag || event.category || "Race control",
    message: event.message,
    driverNumber: event.driver_number,
    lapNumber: event.lap_number,
    time: event.date,
    severity: event.flag?.toLowerCase().includes("red") ? "danger" : event.flag?.toLowerCase().includes("yellow") ? "warning" : "info",
  }))

  const pitEvents: LiveEvent[] = pit.slice(-8).map((event) => ({
    type: "pit",
    title: `Pit stop #${event.driver_number}`,
    message: event.stop_duration ? `${event.stop_duration.toFixed(2)} c на месте` : event.pit_duration ? `${event.pit_duration.toFixed(2)} c в пит-лейне` : undefined,
    driverNumber: event.driver_number,
    lapNumber: event.lap_number,
    time: event.date,
    severity: "info",
  }))

  return [...controlEvents, ...pitEvents]
    .sort((a, b) => Date.parse(b.time || "") - Date.parse(a.time || ""))
    .slice(0, 16)
}

export async function getLatestWeather(sessionKey: number) {
  const weather = await fetchOpenF1<OpenF1Weather>(`weather?session_key=${sessionKey}`, 15 * 1000).catch(() => [])
  const latest = latestBy(weather, (w) => w.date)
  if (!latest) return undefined
  return {
    airTemp: latest.air_temperature,
    trackTemp: latest.track_temperature,
    humidity: latest.humidity,
    rainfall: latest.rainfall,
    windSpeed: latest.wind_speed,
    sampledAt: latest.date,
  }
}
