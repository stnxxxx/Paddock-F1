# Keep the build context small and free of secrets / local artifacts.
.git
.gitignore
node_modules
.next
out
build
coverage
*.tsbuildinfo

# Secrets — never copy env files into the image (except the example).
.env
.env.*
!.env.production.example

# Local-only data and raw drops (DB lives in Postgres; uploads are a runtime volume).
data
public/uploads
F1
cookies.txt
login_result.txt
*.log

# Deploy + docs (not needed inside the image).
Dockerfile
.dockerignore
docker-compose.yml
Caddyfile
DEPLOY.md
.vercel
